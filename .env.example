# Copy to .env (python run.py setup does this and fills SECRET_KEY automatically).
# NEVER commit your real .env file.

# --- Security -------------------------------------------------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REGISTRATION_ENABLED=true

# --- Demo accounts created on first API start (CHANGE THESE before any deployment) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_DEPLOYMENT

DEMO_USERNAME=analyst
DEMO_PASSWORD=CHANGE_THIS_BEFORE_DEPLOYMENT

# --- Database -------------------------------------------------------------------
# Default (leave commented): SQLite file upi_sentinel.db in the project folder.
# DATABASE_URL=sqlite:///./upi_sentinel.db
# MySQL (pip install pymysql):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/upi_sentinel

# --- Networking -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
API_BASE_URL=http://127.0.0.1:8000
# Comma-separated list of browser origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Project-defined risk bands (not an official banking standard) ---------------
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# --- Isolation Forest -----------------------------------------------------------
ANOMALY_CONTAMINATION=0.05
